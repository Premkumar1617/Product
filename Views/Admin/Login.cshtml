@model AdminLoginViewModel
@{
    ViewData["Title"] = "Admin Login";
}
@if (TempData["PasswordChanged"] is bool changed && changed)
{
    <div class="alert alert-success">Password updated — please log in again.</div>
}
<div class="container py-5" style="max-width:420px;">
    <h2 class="mb-4">Admin Login</h2>
    <form asp-controller="Admin" asp-action="Login" method="post">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        <div class="mb-3">
            <label asp-for="Username" class="form-label"></label>
            <input asp-for="Username" class="form-control" autofocus />
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary w-100">Log In</button>
    </form>
</div>