@model List<EnquiryRecord>
@{
    ViewData["Title"] = "Enquiries";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Enquiries (@Model.Count)</h2>
        <form asp-action="Logout" method="post">
            <button type="submit" class="btn btn-outline-secondary btn-sm">Log Out</button>
        </form>
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted">No enquiries yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr><th>Submitted</th><th>Name</th><th>Email</th><th>Phone</th><th>Message</th></tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td>@e.SubmittedAtUtc.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td>
                            <td>@e.Name</td>
                            <td><a href="mailto:@e.Email">@e.Email</a></td>
                            <td>@e.Phone</td>
                            <td>@e.Message</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>