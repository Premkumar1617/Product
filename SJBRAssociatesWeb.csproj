<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Data\Users\" />
  </ItemGroup>

  <!--
    No explicit <Content Include> block needed here: the Web SDK already
    includes everything under the project folder (Data\*.json included) as
    default Content items with CopyToPublishDirectory=PreserveNewest.
    Adding them again manually caused NETSDK1022 (duplicate Content items).
  -->

</Project>
